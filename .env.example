# ─────────────────────────────────────────────
# Skove — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# Database (local: use docker-compose, prod: Supabase)
DATABASE_URL="postgresql://skove:skove_dev@localhost:5432/skove"

# Auth — Clerk (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# API
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT=3001

# Job Scheduler — Trigger.dev (https://trigger.dev)
TRIGGER_API_KEY="tr_dev_..."
TRIGGER_API_URL="https://api.trigger.dev"

# Email — Resend (https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="Skove <hello@skove.app>"

# Payments — Stripe (https://stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Redis (local: docker-compose, prod: Upstash)
REDIS_URL="redis://localhost:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
